rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /records/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','timeMin','rank','of','color','stats','at','pid'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 12
        && request.resource.data.timeMin is number
        && request.resource.data.timeMin > 600 && request.resource.data.timeMin < 2230
        && request.resource.data.rank is int && request.resource.data.rank >= 1 && request.resource.data.rank <= 101
        && request.resource.data.stats is map
        && request.resource.data.pid is string && request.resource.data.pid.size() < 20;
      allow update, delete: if false;
    }
  }
}
